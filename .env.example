# ===== 运行环境 =====
APP_ENV=dev  # dev / test / prod

# ===== 大模型（DeepSeek）=====
LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ===== Embedding / Reranker（硅基流动）=====
EMBED_API_KEY=your_siliconflow_api_key
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-large-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== LangSmith（可选，默认关闭）=====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ecom-customer-bot

# ===== 向量库 =====
CHROMA_PATH=chroma_db
COLLECTION_NAME=ecom_knowledge

# ===== 文档目录 =====
DOCS_DIR=docs

# ===== 检索 =====
TOP_K=3

# ===== 会话存储（SqliteSaver）=====
SQLITE_DB_PATH=checkpoints.db

# ===== 服务配置 =====
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=info

# ===== 请求超时（秒）=====
LLM_TIMEOUT=30
EMBED_TIMEOUT=15
RERANK_TIMEOUT=10

# ===== 限流（每分钟每IP请求数）=====
RATE_LIMIT_PER_MINUTE=30

# ===== Redis（生产环境会话存储，不配置则用 SQLite）=====
REDIS_URL=  # 如 redis://localhost:6379/0

# ===== 输入限制 =====
MAX_MESSAGE_LENGTH=2000
